<diagram id="page1" name="1 Overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c127" value="&lt;b&gt;Concentrate Quest: package overview&lt;/b&gt;&lt;br&gt;&lt;span style=&amp;quot;font-size:12px;color:#555555;&amp;quot;&gt;14 packages, 64 types. Dashed arrows: «use» dependencies. Pages 2 to 4 show every class.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="60" as="geometry"/></mxCell><mxCell id="c128" value="&lt;b&gt;concentratequest&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Main&lt;/span&gt;" style="shape=folder;fontStyle=0;spacingTop=12;tabWidth=60;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="420" height="100" as="geometry"/></mxCell><mxCell id="c129" value="&lt;b&gt;ui.console&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;ConsoleGame, ConsoleInput, ConsoleFormat, ConsoleMissionView&lt;/span&gt;" style="shape=folder;fontStyle=0;spacingTop=12;tabWidth=60;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="420" height="100" as="geometry"/></mxCell><mxCell id="c130" value="&lt;b&gt;ui.swing&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;QuestDialog, BrownNoise&lt;/span&gt;" style="shape=folder;fontStyle=0;spacingTop=12;tabWidth=60;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;fillColor