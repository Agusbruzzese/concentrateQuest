<diagram id="page2" name="2 Hero and items"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Hero, items, inventory, home and shop&lt;/b&gt;&lt;br&gt;&lt;span style=&amp;quot;font-size:12px;color:#555555;&amp;quot;&gt;packages model.hero, model.item, model.inventory, model.home, model.shop&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;font-size:10px;&quot;&gt;«abstract»&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-top:2px;text-align:center;&quot;&gt;&lt;b&gt;&lt;i&gt;Hero&lt;/i&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:3px 0px;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;u&gt;+ STARTING_STAT_POINTS: int&lt;/u&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;u&gt;+ STAT_POINTS_PER_LEVEL: int&lt;/u&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;u&gt;+ BACKPACK_CAPACITY: int&lt;/u&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;u&gt;- BASE_HEALTH: int&lt;/u&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;u&gt;- XP_FOR_LEVEL_2: int&lt;/u&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;u&gt;- EXTRA_XP_PER_LEVEL: int&lt;/u&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- name: String&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- level: int&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- experience: int&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- freeStatPoints: int&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- health: int&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- gold: int&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- baseStats: CharacterStats&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- equipment: Equipment&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- backpack: Inventory&amp;lt;Item&amp;gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- record: FocusRecord&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- home: Home&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:3px 0px;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;# Hero(String, CharacterStats, List&amp;lt;? extends Gear&amp;gt;, List&amp;lt;? extends Item&amp;gt;)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;i&gt;+ getType(): HeroType&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;i&gt;+ getAffinity(): TaskCategory&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;i&gt;# getLevelUpGrowth(): CharacterStats&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;u&gt;- validName(String): String&lt;/u&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ setName(String): void&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ getName(): String&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ getLevel(): int&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ getExperience(): int&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ getExperienceToNextLevel(): int&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ getFreeStatPoints(): int&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ getRecord(): FocusRecord&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ gainExperience(int): int&lt;/p&gt;&lt;p style=&quot;margin:0px;m